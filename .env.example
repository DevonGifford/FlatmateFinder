# Firebase web app configuration (from Firebase Console → Project settings)
VITE_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-with-firebase-measurement-id

# Shared tenant access passwords and the display name associated with each one
VITE_PASSWORD_UNO=replace-with-tenant-password-one
VITE_PASSWORD_ONE=replace-with-tenant-display-name-one
VITE_PASSWORD_DOS=replace-with-tenant-password-two
VITE_PASSWORD_TWO=replace-with-tenant-display-name-two
VITE_PASSWORD_TRES=replace-with-tenant-password-three
VITE_PASSWORD_THREE=replace-with-tenant-display-name-three

# Shared applicant access passwords
VITE_PASSWORD_ALPHA=replace-with-applicant-password-one
VITE_PASSWORD_BETA=replace-with-applicant-password-two
VITE_PASSWORD_MANGO=replace-with-applicant-password-three
VITE_PASSWORD_CHOCOLATE=replace-with-applicant-password-four

# Optional deployment path; use / for local development
VITE_REACT_APP_BASENAME=/
