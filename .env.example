# Firebase public configuration used by the client SDK.
VITE_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
VITE_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Shared tenant passwords and the display name shown after tenant login.
VITE_PASSWORD_UNO=replace-with-tenant-password
VITE_PASSWORD_ONE=replace-with-tenant-password-test
VITE_PASSWORD_DOS=replace-with-tenant-password
VITE_PASSWORD_TWO=replace-with-tenant-password-test
VITE_PASSWORD_TRES=replace-with-tenant-password
VITE_PASSWORD_THREE=replace-with-tenant-password-test

# Shared applicant passwords.
VITE_PASSWORD_ALPHA=replace-with-applicant-password
VITE_PASSWORD_BETA=replace-with-applicant-password
VITE_PASSWORD_OMEGA=replace-with-applicant-password
VITE_PASSWORD_PROD=replace-with-applicant-password

# Optional router basename; leave as / for local development.
VITE_REACT_APP_BASENAME=/
